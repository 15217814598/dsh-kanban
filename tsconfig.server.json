{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./lib",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "dsh-webserver.d.ts",
    "types.ts",
    "store.ts",
    "routes.ts",
    "index.ts",
    "feishu.ts",
    "auto-task-store.ts"
  ],
  "exclude": ["node_modules", "lib", "src"]
}
